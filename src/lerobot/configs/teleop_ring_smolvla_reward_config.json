{
  "name": "smolvla_reward_classifier",
  "num_classes": 2,
  "use_ignore_label": true,
  "ignore_label_value": -1,
  "vlm_model_name": "HuggingFaceTB/SmolVLM2-500M-Video-Instruct",
  "load_vlm_weights": true,
  "freeze_vlm": true,
  "task_description": "Classify if the robot has successfully completed the ring manipulation task. Success means the ring is properly grasped and positioned.",
  "use_task_description": true,
  "hidden_dim": 256,
  "dropout_rate": 0.1,
  "learning_rate": 1e-4,
  "weight_decay": 0.01,
  "device": "cuda",
  "use_amp": true,
  "batch_size": 8,
  "num_epochs": 50,
  "eval_interval": 5,
  "save_interval": 10,
  "dataset_repo_id": "wzn12/teleop_ring",
  "labeled_data_path": "labeled_datasets/teleop_ring_labeled/labeled_data.pt",
  "output_dir": "outputs/smolvla_reward_classifier_teleop_ring",
  "log_interval": 10,
  "num_workers": 4,
  "pin_memory": true,
  "shuffle": true,
  "train_split": 0.8,
  "val_split": 0.2,
  "random_seed": 42
} 