{
  "task": "hilserl_smolvla_sac_ring",
  "output_dir": "outputs/train/smolvla_sac_ring",
  "resume": false,
  "seed": 10000,
  "wandb": {
    "enable": false,
    "job_type": "train",
    "notes": "SmolVLA-SAC training for ring pickup task",
    "project": "lerobot_hilserl",
    "tags": ["smolvla", "sac", "ring", "hilserl"]
  },
  "dataset": {
    "repo_id": "wzn12/teleop_ring",
    "use_imagenet_stats": true
  },
  "env": {
    "type": "gym_manipulator",
    "name": "hilserl_robot_env",
    "pretrained_policy_name_or_path": "outputs/train/2025-08-04/11-43-08_smolvla/checkpoints/008000/pretrained_model",
    "reward_model": {
      "repo_id": "wzn12/reward_classifier_resnet10_ring_224",
      "model_path": "outputs/train/2025-08-04/23-15-14_reward_classifier_resnet10_ring_224/checkpoints/004500/pretrained_model"
    },
    "robot": {
      "type": "so101_follower",
      "port": "/dev/ttyACM1",
      "id": "znw_arm_f1",
      "cameras": {
        "handeye": {
          "type": "opencv",
          "index_or_path": "/dev/video4",
          "width": 800,
          "height": 600,
          "fps": 25
        },
        "global": {
          "type": "opencv", 
          "index_or_path": "/dev/video6",
          "width": 800,
          "height": 600,
          "fps": 25
        }
      }
    },
    "teleop": {
      "type": "so101_leader",
      "port": "/dev/ttyACM0",
      "id": "znw_arm_l1"
    },
    "single_task": "pick up the black ring",
    "episode_time_s": 100,
    "device": "cuda"
  },
  "policy": {
    "type": "smolvla_sac",
    "device": "cuda",
    "use_amp": false,
    "vlm_model_name": "Qwen/Qwen2.5-0.5B-Instruct",
    "chunk_size": 256,
    "n_action_steps": 1,
    "max_state_dim": 128,
    "max_action_dim": 128,
    "tokenizer_max_length": 1024,
    "num_steps": 1000,
    "use_cache": true,
    "attention_mode": "causal",
    "prefix_length": 0,
    "pad_language_to": 64,
    "num_expert_layers": 12,
    "num_vlm_layers": 18,
    "self_attn_every_n_layers": 3,
    "expert_width_multiplier": 4,
    "min_period": 1,
    "max_period": 10000,
    "input_features": {
      "handeye": {
        "type": "IMAGE",
        "shape": [3, 480, 640]
      },
      "global": {
        "type": "IMAGE", 
        "shape": [3, 480, 640]
      },
      "state": {
        "type": "STATE",
        "shape": [6]
      }
    },
    "output_features": {
      "action": {
        "type": "ACTION",
        "shape": [6]
      }
    },
    "normalization_mapping": {
      "action": "action",
      "handeye": "handeye",
      "global": "global",
      "state": "state"
    },
    "actor_learner_config": {
      "host": "127.0.0.1",
      "port": 50051,
      "timeout": 30
    },
    "concurrency": {
      "type": "process"
    },
    "storage_device": "cpu",
    "grad_clip_norm": 40.0,
    "online_step_before_learning": 100,
    "online_steps": 1000000,
    "online_buffer_capacity": 100000,
    "offline_buffer_capacity": 100000,
    "policy_update_freq": 1,
    "discount": 0.99,
    "temperature_init": 1.0,
    "num_critics": 2,
    "critic_lr": 3e-4,
    "actor_lr": 3e-4,
    "temperature_lr": 3e-4,
    "critic_target_update_weight": 0.005,
    "utd_ratio": 1,
    "state_encoder_hidden_dim": 256,
    "latent_dim": 256,
    "target_entropy": null,
    "use_backup_entropy": true,
    "vision_encoder_name": "resnet18",
    "image_encoder_hidden_dim": 256,
    "shared_encoder": false,
    "num_discrete_actions": null,
    "image_embedding_pooling_dim": 8,
    "use_torch_compile": false,
    "freeze_smolvla_for_critic": true
  }
}