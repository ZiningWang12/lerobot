{
  "job_name": "critic_warmup_smolvla_ring",
  "dataset": {
    "repo_id": "wzn12/teleop_ring_labeled",
    "root": null,
    "use_imagenet_stats": false,
    "image_transforms": {
      "enable": false
    }
  },
  "policy": {
    "type": "smolvla_sac",
    "smolvla_path": null,
    "num_critics": 2,
    "critic_lr": 3e-4,
    "actor_lr": 0.0,
    "temperature_lr": 0.0,
    "state_encoder_hidden_dim": 256,
    "latent_dim": 256,
    "vision_encoder_name": "helper2424/resnet10",
    "image_encoder_hidden_dim": 256,
    "shared_encoder": false,
    "freeze_smolvla_for_critic": true,
    "use_torch_compile": true,
    "discount": 0.99,
    "temperature_init": 1.0,
    "critic_target_update_weight": 0.005,
    "num_steps": 10,
    "target_entropy": null,
    "use_backup_entropy": true,
    "device": "cuda",
    "use_amp": false,
    "repo_id": "wzn12/critic_warmup_smolvla_ring",
    "push_to_hub": true,
    "input_features": {
      "observation.images.handeye": {"type": "VISUAL", "shape": [3, 600, 800]},
      "observation.images.global": {"type": "VISUAL", "shape": [3, 600, 800]},
      "observation.state": {"type": "STATE", "shape": [6]}
    },
    "output_features": {
      "action": {"type": "ACTION", "shape": [6]}
    }
  },
  "output_dir": "outputs/train/critic_warmup_smolvla_ring",
  "batch_size": 48,
  "epochs": 20,
  "save_freq": 1,
  "eval_freq": 2,
  "log_freq": 10,
  "num_workers": 4,
  "max_samples": 4000,
  "train_test_split": 0.8,
  "optimizer": {
    "type": "adam",
    "lr": 3e-4,
    "weight_decay": 1e-4,
    "grad_clip_norm": 1.0
  },
  "scheduler": {
    "type": "step",
    "step_size": 2,
    "gamma": 0.9
  },
  "wandb": {
    "enable": true,
    "project": "lerobot_critic_warmup",
    "entity": null,
    "notes": "Critic offline warmup training for SmolVLA-SAC policy",
    "tags": ["critic", "warmup", "smolvla", "ring"],
    "mode": "online",
    "disable_artifact": false
  },
  "seed": 42
}